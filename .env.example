# Optional Meta Pixel integration
# Add this in the deployment environment to enable Meta PageView + NOVA custom events.
NEXT_PUBLIC_META_PIXEL_ID=

# Optional comma-separated Easy Orders product IDs approved for the NOVA storefront
NOVA_EASY_ORDERS_PRODUCT_IDS=

# Easy Orders sales/orders integration
# Use a key with orders:read permission.
# Current EasyOrders public API mode uses Bearer auth against /v1/orders.
NOVA_EASY_ORDERS_ORDERS_URL=https://api.easy-orders.net/v1/orders
NOVA_EASY_ORDERS_AUTH_MODE=bearer

# Protect the private NOVA sales dashboard API.
NOVA_SALES_DASHBOARD_TOKEN=
